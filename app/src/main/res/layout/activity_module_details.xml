<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background_color"
    tools:context=".Activities.Classroom.Activities.Module_Details_Activity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/module_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/page_color"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_8sdp">

            <!-- Back Arrow and Course Image -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/round_arrow_back" />

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:cardCornerRadius="5dp">

                    <ImageView
                        android:id="@+id/course_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/aswan_profile_pic" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/courseToolBarName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:elevation="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/youtube_sans_dark_extrabold"
                    android:maxLines="1"
                    android:paddingStart="10dp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/_12sdp" />
            </LinearLayout>

            <!-- Search Icon -->
            <RelativeLayout
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp">
                <ImageView
                    android:id="@+id/incomplete"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/btn_complete" />
                <ImageView
                    android:id="@+id/complete"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    android:layout_centerInParent="true"
                    android:visibility="gone"
                    android:src="@drawable/green_check" />
            </RelativeLayout>

            <ImageView
                android:id="@+id/course_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/option" />

        </LinearLayout>


        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/module_toolbar"
            android:layout_gravity="center_vertical"
            android:elevation="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/youtube_sans_dark_extrabold"
            android:maxLines="2"
            android:paddingStart="20dp"
            android:paddingTop="15dp"
            android:paddingEnd="20dp"
            android:paddingBottom="15dp"
            android:textColor="@color/text_white"
            android:textSize="@dimen/_18sdp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_160sdp"
            android:layout_below="@+id/title"
            android:layout_margin="@dimen/_8sdp"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="@dimen/_5sdp">

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:autoPlay="false" />

        </androidx.cardview.widget.CardView>


        <TextView
            android:id="@+id/descryption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/player"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

    </RelativeLayout>
</androidx.core.widget.NestedScrollView>