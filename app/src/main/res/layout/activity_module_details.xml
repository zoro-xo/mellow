<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background_color"
    tools:context=".Activities.Classroom.Activities.Module_Details_Activity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/module_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/page_color"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_8sdp">

            <!-- Back Arrow and Course Image -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/round_arrow_back" />

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    app:cardCornerRadius="5dp"
                    android:layout_marginStart="@dimen/_10sdp">
                    <ImageView
                        android:id="@+id/course_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="2dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/mellow_logo"/>
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/courseToolBarName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:elevation="2dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/youtube_sans_dark_extrabold"
                    android:maxLines="1"
                    android:paddingEnd="@dimen/_10sdp"
                    android:text="Experimental schosdhzgjlkfgsdkhghdaskhjfgkhjsdgfkhgol"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/_12sdp" />
            </LinearLayout>

            <!-- Search Icon -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                android:src="@drawable/btn_complete" />

            <ImageView
                android:id="@+id/course_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/option" />

        </LinearLayout>


        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/module_toolbar"
            android:layout_gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:elevation="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/youtube_sans_dark_extrabold"
            android:maxLines="2"
            android:text="Experimental school"
            android:textColor="@color/text_white"
            android:textSize="@dimen/_18sdp"  />

        <androidx.cardview.widget.CardView
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_160sdp"
            android:layout_margin="@dimen/_8sdp"
            app:cardCornerRadius="@dimen/_8sdp"
            android:layout_below="@+id/title"
            app:cardElevation="@dimen/_5sdp">

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/video_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:autoPlay="false" />

        </androidx.cardview.widget.CardView>


        <TextView
            android:id="@+id/descryption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_below="@+id/player"
            android:text="However, for relatively small video files around 20 MB, the performance benefits of using streams may be less significant compared to handling larger files. If your use case involves only small video files and simplicity is a priority, you could consider using the built-in fs.readFile() and fs.writeFile() functions instead of streams. These functions load the entire file into memory at once, which may be acceptable for small file sizes." />


    </RelativeLayout>
</androidx.core.widget.NestedScrollView>