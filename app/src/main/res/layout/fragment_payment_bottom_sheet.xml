<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/_5sdp"
    style="@style/AppBottomSheetDialogThemeDark"
    android:background="@drawable/bg_bottomsheet"
    tools:context=".Activities.Classroom.fragments.PaymentBottomSheet">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Course Fees"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_10sdp"
        android:textSize="@dimen/_15ssp"

        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You have to pay a fees to join community"
        android:gravity="center"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:textSize="@dimen/_15ssp"

        />
    <TextView
        android:id="@+id/amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="₹ 79.00 "
        android:gravity="center"
        android:textSize="@dimen/_25ssp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/_10sdp"

        />
    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pay"
        android:id="@+id/btnPay"
        android:background="@drawable/sign_enabled"
        android:textColor="@color/black"
        android:layout_margin="@dimen/_10sdp"
        />

</LinearLayout>